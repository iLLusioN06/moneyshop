prisma:query 
    SELECT
      DATE_TRUNC('month', date)  AS month,
      type,
      COALESCE(SUM(amount), 0)   AS total
    FROM transactions
    WHERE
      "userId"    = $1
      AND status  = 'COMPLETED'
      AND date    >= $2
      AND type    IN ('INCOME', 'EXPENSE')
    GROUP BY DATE_TRUNC('month', date), type
    ORDER BY month ASC
  
