prisma:query SELECT SUM("amount") AS "_sum$amount" FROM (SELECT "public"."transactions"."amount" FROM "public"."transactions" WHERE ("public"."transactions"."userId" = $1 AND "public"."transactions"."type" = CAST($2::text AS "public"."TransactionType") AND "public"."transactions"."date" >= $3 AND "public"."transactions"."date" < $4 AND "public"."transactions"."status" = CAST($5::text AS "public"."TransactionStatus")) OFFSET $6) AS "sub"
prisma:query 
    SELECT
      DATE_TRUNC('month', date)  AS month,
      type,
      COALESCE(SUM(amount), 0)   AS total
    FROM transactions
    WHERE
      "userId"    = $1
      AND status  = 'COMPLETED'
      AND date    >= $2
      AND type    IN ('INCOME', 'EXPENSE')
    GROUP BY DATE_TRUNC('month', date), type
    ORDER BY month ASC
  
