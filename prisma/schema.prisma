// =============================================
// MoneyShop - Prisma Şeması
// =============================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// Auth Modelleri (NextAuth v5 uyumlu)
// =============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  phone         String    @default("")
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              FinancialAccount[]
  categories            Category[]
  budgets               Budget[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  investments           Investment[]
  auditLogs             AuditLog[]
  sessions              Session[]
  accounts_             AuthAccount[]
  emailSettings         EmailNotificationSetting[]
  emailLogs             EmailLog[]
  cards                 Card[]
}

model AuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================
// Denetim Günlüğü (Audit Log)
// =============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String                        // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | VERIFY | etc.
  entity    String                        // "USER" | "ACCOUNT" | "TRANSACTION" | "TRANSFER" | etc.
  entityId  String?                       // İlgili kaydın ID'si (opsiyonel)
  details   Json?    @default("{}")       // Değişiklik detayları
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================
// Yatırım Takibi
// =============================================

model Investment {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  name        String                        // Örn: "Apple", "BTC", "Altın"
  symbol      String                        // Örn: "AAPL", "BTC", "XAU"
  type        String   @default("STOCK")    // STOCK | CRYPTO | COMMODITY | FUND | OTHER
  shares      Float                         // Adet / Miktar
  buyPrice    Float                         // Birim alış fiyatı
  currentPrice Float   @default(0)          // Güncel birim fiyat (manuel girilir)
  currency    String   @default("TRY")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@map("investments")
}

// =============================================
// SMS Doğrulama (Kayıt)
// =============================================

model PendingRegistration {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  password  String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("pending_registrations")
}

// =============================================
// Finansal Modeller
// =============================================

model FinancialAccount {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   @default("CHECKING")
  balance   Float    @default(0)
  currency  String   @default("TRY")
  icon      String?
  color     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]
  investments           Investment[]

  @@index([userId])
  @@map("financial_accounts")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String   @default("circle")
  color     String   @default("#94a3b8")
  type      String   @default("EXPENSE")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id          String   @id @default(cuid())
  accountId   String
  userId      String
  categoryId  String?
  type        String   @default("EXPENSE")
  amount      Float
  currency    String   @default("TRY")
  description String?
  status      String   @default("COMPLETED")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Transfer bilgileri
  recipientName  String?
  recipientIban  String?
  recipientBank  String?
  transferFee    Float    @default(0)
  // Para transferlerinde karşı tarafın kullanıcı ID'si (MoneyShop içi transferlerde)
  recipientUserId String?
  // MoneyShop Card işlemlerinde kart ID'si
  cardId String?

  card Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  account  FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([date])
  @@map("transactions")
}

model Budget {
  id         String    @id @default(cuid())
  userId     String
  categoryId String
  amount     Float
  spent      Float     @default(0)
  currency   String    @default("TRY")
  period     String    @default("MONTHLY")
  startDate  DateTime  @default(now())
  endDate    DateTime?
  createdAt  DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
  @@map("budgets")
}

// =============================================
// Tekrarlanan İşlemler
// =============================================

model RecurringTransaction {
  id            String   @id @default(cuid())
  userId        String
  accountId     String
  categoryId    String?
  type          String   @default("EXPENSE")   // INCOME | EXPENSE | TRANSFER
  amount        Float
  currency      String   @default("TRY")
  description   String?
  frequency     String                        // DAILY | WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY | YEARLY
  intervalCount Int      @default(1)           // Her N periyotta bir
  dayOfMonth    Int?                           // Ayın kaçında (MONTHLY/QUARTERLY/YEARLY için)
  dayOfWeek     Int?                           // Haftanın kaçıncı günü (WEEKLY için, 0=Pazar)
  startDate     DateTime
  endDate       DateTime?                      // null = süresiz
  nextDate      DateTime                       // Bir sonraki işlem tarihi
  lastProcessed DateTime?
  status        String   @default("ACTIVE")    // ACTIVE | PAUSED | COMPLETED | CANCELLED
  totalOccurrences Int?                          // Toplam tekrar sayısı (null=sınırsız)
  occurrenceCount Int    @default(0)            // Gerçekleşen tekrar sayısı
  transferRecipientName  String?                // TRANSFER için alıcı adı
  transferRecipientIban  String?                // TRANSFER için IBAN
  transferRecipientBank  String?                // TRANSFER için banka
  recipientUserId String?                       // MoneyShop içi transfer alıcı ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@index([nextDate])
  @@map("recurring_transactions")
}

// =============================================
// MoneyShop Card
// =============================================

model Card {
  id            String   @id @default(cuid())
  userId        String
  cardType      String   @default("STANDARD")     // STANDARD | SILVER | GOLD
  cardNumber    String   @unique                   // Şifrelenmiş kart numarası
  cardHolderName String
  expiryMonth   Int
  expiryYear    Int
  cvv           String                             // Şifrelenmiş CVV
  status        String   @default("ACTIVE")        // ACTIVE | BLOCKED | CANCELLED | PENDING
  dailyLimit    Float    @default(5000)
  monthlyLimit  Float    @default(50000)
  currentDailySpent  Float @default(0)
  currentMonthlySpent Float @default(0)
  balance       Float    @default(0)
  currency      String   @default("IQD")
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([status])
  @@map("cards")
}

// =============================================
// E-posta Bildirimleri
// =============================================

model EmailNotificationSetting {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String                        // Bildirimlerin gönderileceği e-posta adresi
  enabled   Boolean  @default(false)      // Master toggle
  // Event toggles
  onTransaction Boolean @default(true)    // Yeni işlem eklendiğinde
  onTransfer    Boolean @default(true)    // Para transferi gerçekleştiğinde
  onBudgetAlert Boolean @default(true)    // Bütçe limiti aşıldığında
  onMonthlyReport Boolean @default(false) // Aylık özet rapor
  onLargeTransaction Boolean @default(true) // Yüksek tutarlı işlem (>10000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_notification_settings")
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String
  to        String                        // Alıcı e-posta adresi
  subject   String                        // E-posta konusu
  body      String   @db.Text             // E-posta içeriği (düz metin)
  event     String                        // TRANSACTION | TRANSFER | BUDGET_ALERT | MONTHLY_REPORT | TEST
  status    String   @default("SENT")     // SENT | FAILED
  error     String?                       // Hata mesajı (varsa)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("email_logs")
}
