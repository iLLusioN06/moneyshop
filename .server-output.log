prisma:query SELECT SUM("public"."transactions"."amount") AS "_sum$amount", "public"."transactions"."categoryId" FROM "public"."transactions" WHERE ("public"."transactions"."userId" = $1 AND "public"."transactions"."type" = CAST($2::text AS "public"."TransactionType") AND "public"."transactions"."date" >= $3 AND "public"."transactions"."status" = CAST($4::text AS "public"."TransactionStatus") AND "public"."transactions"."categoryId" IS NOT NULL) GROUP BY "public"."transactions"."categoryId" ORDER BY SUM("public"."transactions"."amount") DESC OFFSET $5
prisma:query 
    SELECT
      DATE_TRUNC('month', date)  AS month,
      type,
      COALESCE(SUM(amount), 0)   AS total
    FROM transactions
    WHERE
      "userId"    = $1
      AND status  = 'COMPLETED'
      AND date    >= $2
      AND type    IN ('INCOME', 'EXPENSE')
    GROUP BY DATE_TRUNC('month', date), type
    ORDER BY month ASC
  
